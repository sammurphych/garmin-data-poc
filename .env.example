# Local development only. Copy to .env (gitignored). In Prefect Cloud these come from Secret blocks.

# Garmin Connect personal API key (Garmin Connect web > Personal API). Exchanged for a 24h token on every run.
GARMIN_API_KEY=

# First date to backfill on the very first load (YYYY-MM-DD).
GARMIN_START_DATE=2009-12-01

# Where dlt + SQLMesh write: "motherduck" or "local" (local = ./health.duckdb)
WAREHOUSE=local

# MotherDuck read/write token (pipeline). MOTHERDUCK_READ_TOKEN is a separate token for Cube/Evidence:
# read-only (Read Scaling) needs the Business plan, so on the free plan it is a second regular token.
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=health

# Cube (semantic/docker-compose.yml) + MCP server
MOTHERDUCK_READ_TOKEN=
CUBEJS_API_SECRET=change-me-to-a-long-random-string
# Cube on Render: https://<service>.onrender.com/cubejs-api/v1 (or http://localhost:4000/cubejs-api/v1 locally)
CUBE_API_URL=http://localhost:4000/cubejs-api/v1

# Local model for semantic/local_chat.py (llama-server's OpenAI-compatible API)
LLM_BASE_URL=http://localhost:8080/v1

# SQLMesh state database for the motherduck gateway (Postgres, e.g. a free Neon project).
# Leave empty to keep SQLMesh state in MotherDuck. Prefect reads it from Secret `sqlmesh-state-db-url`.
SQLMESH_STATE_DB_URL=

# Withings (developer.withings.com app). Withings rejects localhost callbacks, so the callback
# is a page on the Netlify site. The rotating refresh token lives in the Prefect Secret
# `withings-refresh-token`; create it once with:  uv run python -m ingest.withings_auth
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=https://YOUR-SITE.netlify.app/withings-callback.html
