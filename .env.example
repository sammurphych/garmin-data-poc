# Local development only. Copy to .env (gitignored). In Prefect Cloud these come from Secret blocks.

# Garmin Connect personal API key (Garmin Connect web > Personal API). Exchanged for a 24h token on every run.
GARMIN_API_KEY=

# First date to backfill on the very first load (YYYY-MM-DD).
GARMIN_START_DATE=2009-12-01

# Where dlt + SQLMesh write: "motherduck" or "local" (local = ./health.duckdb)
WAREHOUSE=local

# MotherDuck read/write token (pipeline). Use a read-only token for Cube/Evidence.
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=health

# Cube (semantic/docker-compose.yml) + MCP server
MOTHERDUCK_READ_TOKEN=
CUBEJS_API_SECRET=change-me-to-a-long-random-string
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
